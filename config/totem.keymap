#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define SYMB  1
#define FUNC  2
#define NAVI  3
#define MOUS  4
#define SYST  5

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
            &kp Q             &kp W            &kp E     &kp R               &kp T                 &kp Y             &kp U                &kp I       &kp O            &kp P
            &mt LEFT_SHIFT A  &mt RIGHT_ALT S  &lt 1 D   &mt LEFT_CONTROL F  &mt LEFT_ALT G        &mt LEFT_ALT H    &mt RIGHT_CONTROL J  &lt 1 K     &mt RIGHT_ALT L  &mt RIGHT_SHIFT SEMI
&kp ESCAPE  &kp Z             &kp X            &kp C     &kp V               &kp B                 &kp N             &kp M                &kp COMMA   &kp DOT          &kp SLASH             &to 6
                                               &sl FUNC  &lt 4 ESCAPE        &mt LEFT_GUI SPACE    &mt LEFT_GUI RET  &lt 3 BACKSPACE      &kp C_MENU
            >;
        };

        SYMB {
            display-name = "Symbols";
            bindings = <
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
&trans      &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans    &trans
                            &trans     &trans                  &trans                 &trans             &trans            &trans
            >;
        };

        FUNC {
            display-name = "Function";
            bindings = <
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
&trans      &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans    &trans
                            &trans     &trans                  &trans                 &trans             &trans            &trans
            >;
        };

        NAVI {
            display-name = "Navigation";
            bindings = <
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
&trans      &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans    &trans
                            &trans     &trans                  &trans                 &trans             &trans            &trans
            >;
        };

        MOUS {
            display-name = "Mouse";
            bindings = <
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
&trans      &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans    &trans
                            &trans     &trans                  &trans                 &trans             &trans            &trans
            >;
        };

        SYST {
            display-name = "System";
            bindings = <
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
            &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans
&trans      &trans  &trans  &trans     &trans                  &trans                 &trans             &trans            &trans      &trans    &trans    &trans
                            &trans     &trans                  &trans                 &trans             &trans            &trans
            >;
        };
    };
};
